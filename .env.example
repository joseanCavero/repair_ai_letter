# Copy to .env and fill in real values. Never commit .env.

# OpenAI API key used by the LangChain OpenAI integration
OPENAI_API_KEY=sk-your-openai-api-key-here

# API key callers must send in the X-API-Key header. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, the generation endpoint fails closed (503).
REPAIR_AI_API_KEY=your-service-api-key-here

# Model used for generation (any OpenAI chat model with structured output support)
REPAIR_AI_MODEL_NAME=gpt-4o-mini

# Deterministic generation
REPAIR_AI_MODEL_TEMPERATURE=0

# Operational limits (defaults shown)
# REPAIR_AI_MODEL_TIMEOUT_SECONDS=30
# REPAIR_AI_MODEL_MAX_RETRIES=1
# REPAIR_AI_MODEL_MAX_OUTPUT_TOKENS=800
# REPAIR_AI_MAX_REQUEST_BODY_BYTES=262144
